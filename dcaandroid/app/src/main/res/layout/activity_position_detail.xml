<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="6dp"
    tools:context=".dcanew.ui.PositionDetail">

    <!-- Summary Section -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp"
        android:layout_margin="4dp"
        android:padding="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:background="@color/main3"
            android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:orientation="horizontal"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tv_coin_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bitcoin (BTC)"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:layout_weight="0.5"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tv_tradeStatus_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Status: Hold"
                android:textColor="@color/main2"
                android:textSize="14sp"
                android:layout_weight="1"
                android:textStyle="bold"/>
            <ImageView
                android:layout_width="25dp"
                android:id="@+id/PositionDetailCloseButton"
                android:src="@drawable/baseline_cancel_24"
                android:layout_height="25dp"

                ></ImageView>

        </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:orientation="horizontal"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tv_initial_coin_amount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/black"
                    android:text="Initial Amount: -"
                    android:textSize="12sp"/>

                <TextView
                    android:id="@+id/tv_current_coin_amount"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:text="Current Amount: -"
                    android:textColor="@color/black"
                    android:textSize="12sp" />

            </LinearLayout>



        <LinearLayout
            android:layout_width="match_parent"
            android:orientation="horizontal"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/tv_initial_buy_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/black"
                android:text="Initial Buy Price: -"
                android:textSize="12sp"/>
            <TextView
                android:id="@+id/tv_avergae_buy_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:textColor="@color/black"
                android:text="Average Buy Price: -"
                android:textSize="12sp"/>
        </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_total_pnl"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="total PNL: -"
                    android:textSize="12sp"
                    android:layout_weight="1"
                    android:textColor="@color/black"/>
                <TextView
                    android:id="@+id/currentprice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Current Price: -"
                    android:gravity="end"
                    android:background="@color/main2"
                    android:layout_weight="1"
                    android:textSize="12sp"
                    android:textColor="@color/main3"/>
            </LinearLayout>

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:src="@drawable/b1_line"
                android:layout_marginBottom="4dp">
            </ImageView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/tv_available_coin_amount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/black"
                    android:text="Available Coin: -"
                    android:textSize="12sp"/>
                <TextView
                    android:id="@+id/tv_available_usd_amount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:textColor="@color/black"
                    android:text="Available Usd: -"
                    android:textSize="12sp"/>

            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:cardCornerRadius="12dp"
        android:layout_weight="1"
        app:cardElevation="4dp"
        android:padding="16dp">
    <!-- RecyclerView for Trade History -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_trades_recycler_View"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/main3"
            android:clipToPadding="false"
            android:padding="10dp"
            android:paddingBottom="12dp" />
    </androidx.cardview.widget.CardView>
    <!-- Trading Section -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="3dp"
        android:elevation="2dp">
        <Button
            android:id="@+id/btn_sell"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:text="SELL"
            android:backgroundTint="@color/red"
            android:textColor="@android:color/white"/>

        <Button
            android:id="@+id/btn_buy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BUY"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:backgroundTint="@color/green"
            android:textColor="@android:color/white"/>

    </LinearLayout>
</LinearLayout>
