<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:paddingBottom="16dp"
    tools:context=".dcanew.ui.fragments.home.FragmentHome">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:orientation="vertical"
        tools:context=".dcanew.ui.activities.BitCollector">

        <androidx.cardview.widget.CardView
            xmlns:android="http://schemas.android.com/apk/res/android"
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:elevation="5dp"
            app:cardCornerRadius="10dp"
            android:padding="10dp"
            android:layout_marginBottom="10dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="10dp">

                <ImageView
                    android:layout_width="25dp"
                    android:src="@drawable/bitcoinlogo"
                    android:layout_centerInParent="true"
                    android:layout_marginRight="5dp"
                    android:layout_toLeftOf="@id/title_text"
                    android:layout_height="25dp">

                </ImageView>
                <!-- Centered Title -->
                <TextView
                    android:id="@+id/title_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bit Collector "

                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:layout_centerInParent="true"/>

                <!-- User Icon on Right (Middle) -->
                <ImageView
                    android:id="@+id/profile_icon"
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:src="@drawable/baseline_person_24"

                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"/>

            </RelativeLayout>
        </androidx.cardview.widget.CardView>




        <!-- CardView containing the inputs for position -->


        <!-- Button and History Button Section -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:elevation="5dp"
            app:cardCornerRadius="8dp"
            android:layout_marginTop="2dp">

            <!-- All Sections Inside One CardView -->
            <LinearLayout
                android:layout_width="match_parent"
                android:orientation="vertical"
                android:layout_height="wrap_content"
                android:padding="16dp">

                <!-- Current Price Section Inside CardView -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:elevation="5dp"
                    app:cardCornerRadius="8dp"
                    android:layout_marginBottom="16dp">

                    <!-- Current Price Text Section -->
                    <TextView
                        android:id="@+id/currentprice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="BTC: 0$ ETH: 0$ LTC: 0$ ADA: 0$"
                        android:textSize="12sp"
                        android:layout_gravity="center"
                        android:textStyle="bold"
                        android:background="@color/main"
                        android:textColor="@color/main3"
                        android:gravity="center"
                        android:padding="8dp" />
                </androidx.cardview.widget.CardView>

                <!-- Profit/Loss Summary Section Inside CardView -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:elevation="5dp"
                    app:cardCornerRadius="8dp"
                    android:layout_marginBottom="8dp">

                    <!-- Profit/Loss Summary Section -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:orientation="horizontal"
                        android:layout_height="wrap_content">

                        <TextView
                            android:id="@+id/TotalProfitLoss"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:text="Total Profit/Loss: $0"
                            android:textSize="14sp"
                            android:gravity="center"
                            android:layout_weight="1"
                            android:textColor="@color/black"

                            android:background="@color/green"
                            android:textStyle="bold"
                            android:padding="8dp"/>

                        <TextView
                            android:id="@+id/TotalMoneyUsd"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:text="Total $ in Positions: $0"
                            android:textSize="14sp"
                            android:gravity="center"
                            android:layout_weight="1"
                            android:background="@color/main3"
                            android:textStyle="bold"
                            android:textColor="@color/black"
                            android:padding="8dp"/>
                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:elevation="5dp"
                    app:cardCornerRadius="8dp"
                    android:layout_marginBottom="8dp">

                    <!-- Profit/Loss Summary Section -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:orientation="horizontal"
                        android:layout_height="wrap_content">

                        <TextView
                            android:id="@+id/TotalFreeMoney"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:text="Available Amount: "
                            android:textSize="14sp"
                            android:gravity="center"
                            android:textColor="@color/black"

                            android:layout_weight="1"
                            android:background="@color/main2"
                            android:textStyle="bold"
                            android:padding="8dp"/>

                        <TextView
                            android:id="@+id/TotalCurrentMoneyUsd"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:text="Current Balance: $0"
                            android:textSize="14sp"
                            android:gravity="center"
                            android:textColor="@color/black"
                            android:layout_weight="1"
                            android:background="#EDA58E"
                            android:textStyle="bold"
                            android:padding="8dp"/>
                    </LinearLayout>

                </androidx.cardview.widget.CardView>
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:elevation="5dp"
                    app:cardCornerRadius="8dp"
                    android:layout_marginBottom="8dp">

                    <!-- Profit/Loss Summary Section -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:orientation="horizontal"
                        android:layout_height="wrap_content">

                        <TextView
                            android:id="@+id/TotalMoneyInCrypto"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:text="Total Money in Crypto: "
                            android:textSize="14sp"
                            android:textColor="@color/black"
                            android:gravity="center"
                            android:layout_weight="1"
                            android:background="@color/main3"
                            android:textStyle="bold"
                            android:padding="8dp"/>


                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <Button
                    android:id="@+id/btnCurrentPositions"
                    android:layout_width="match_parent"

                    android:layout_height="wrap_content"
                    android:text="My Positions"
                    android:textColor="@color/main3"
                    android:layout_weight="1"
                    android:textSize="14sp" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:elevation="5dp"
            app:cardCornerRadius="10dp"
            android:layout_marginTop="8dp">

            <!-- Inside CardView: LinearLayout for Inputs -->
            <LinearLayout
                android:layout_width="match_parent"
                android:orientation="vertical"
                android:layout_height="wrap_content"
                android:padding="16dp">

                <!-- Coin Price Input Section -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:orientation="horizontal"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_width="wrap_content"
                        android:text="Coin Price  "
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:padding="10dp"
                        android:layout_height="wrap_content"/>

                    <EditText
                        android:id="@+id/BuyPrice"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:padding="10dp"
                        android:textSize="14sp"
                        android:hint="115"
                        android:inputType="numberDecimal" />

                    <Spinner
                        android:layout_width="wrap_content"
                        android:id="@+id/coin_Name_spinner"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <!-- Amount in Coin Input Section -->


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="8dp">

                    <FrameLayout
                        android:id="@+id/toggleContainer"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">

                        <!-- Amount in Coin Input Section -->
                        <LinearLayout
                            android:id="@+id/amountLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:visibility="visible">

                            <TextView
                                android:layout_width="wrap_content"
                                android:text="Amount      "
                                android:textStyle="bold"
                                android:padding="10dp"
                                android:textSize="14sp"
                                android:layout_height="wrap_content"/>

                            <EditText
                                android:id="@+id/AmountinCoin"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:hint="0.5"
                                android:padding="10dp"
                                android:textSize="14sp"
                                android:inputType="numberDecimal" />
                        </LinearLayout>

                        <!-- Value in USD Input Section -->
                        <LinearLayout
                            android:id="@+id/valueLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:visibility="gone">

                            <TextView
                                android:layout_width="wrap_content"
                                android:text="Value          "
                                android:textStyle="bold"
                                android:padding="10dp"
                                android:textSize="14sp"
                                android:layout_height="wrap_content"/>

                            <EditText
                                android:id="@+id/ValueinUSD"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:hint="50 USD"
                                android:textSize="14sp"
                                android:padding="10dp"
                                android:inputType="numberDecimal" />
                        </LinearLayout>
                    </FrameLayout>

                    <ImageView
                        android:id="@+id/exchangeButtonHomeFragment"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/_977471_economic_sustainability_business_money_financial_icon"
                        android:contentDescription="Toggle input"
                        android:padding="8dp" />
                </LinearLayout>
            </LinearLayout>

        </androidx.cardview.widget.CardView>


    </LinearLayout>
</ScrollView>