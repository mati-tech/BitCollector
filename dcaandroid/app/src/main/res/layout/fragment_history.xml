<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingTop="15dp"
    android:padding="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_height="wrap_content">

        <com.google.android.material.button.MaterialButton
            android:layout_width="wrap_content"
            android:text="All Positions"
            android:textColor="@color/main3"
            android:id="@+id/allPostions"
            android:layout_height="wrap_content" />

        <com.google.android.material.button.MaterialButton
            android:layout_width="wrap_content"
            android:text="+PNL"
            android:textColor="@color/main3"
            android:id="@+id/pluspnl"
            android:layout_height="wrap_content" />

        <com.google.android.material.button.MaterialButton
            android:layout_width="wrap_content"
            android:text="-PNL"
            android:textColor="@color/main3"
            android:id="@+id/minusPnl"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <!-- NEW: Total PnL TextViews -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="8dp">

        <TextView
            android:id="@+id/total_plus_pnl"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Total +PNL: $0.00"
            android:textStyle="bold"
            android:textColor="#4CAF50"
            android:paddingEnd="16dp" />

        <TextView
            android:id="@+id/total_minus_pnl"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Total -PNL: $0.00"
            android:textStyle="bold"
            android:textColor="#F44336" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:layout_width="match_parent"
        android:id="@+id/history_recycler"
        android:padding="3dp"
        android:layout_height="match_parent" />
</LinearLayout>
