<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="2dp"
    android:elevation="8dp"
    android:radius="8dp"
    android:background="@color/white"
    app:cardCornerRadius="8dp"
    app:cardElevation="4dp">

    <!-- Original LinearLayout Content -->
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="6dp">



<!-- List of Buy/Sell Transactions -->
<LinearLayout
    android:id="@+id/tradeHistoryLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Example Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        >

        <TextView
            android:id="@+id/tvTradeType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BUY"
            android:textSize="14sp"
            android:layout_weight="1"
            android:textColor="@color/green"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tvTradeAmountitem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="0.5 BTC"

            android:gravity="end"
            android:textSize="12sp"
            android:textColor="@color/black"/>


    </LinearLayout>

</LinearLayout>

<!-- Total Holdings & Average Buy Price -->
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingTop="8dp">

    <TextView
        android:id="@+id/tvBuyPriceitem"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Buy Price: $25,500"
        android:layout_weight="1"
        android:textColor="@color/black"
        android:gravity="start"
        android:textSize="12sp"/>
    <TextView
        android:id="@+id/tvTradePriceitem"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="$28,000"
        android:layout_weight="1"
        android:textSize="12sp"
        android:gravity="end"
        android:textColor="@color/black"/>

</LinearLayout>

</LinearLayout>

    </androidx.cardview.widget.CardView>
