<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="10dp"

    android:elevation="10dp">

    <!-- Coin Name -->
    <TextView
        android:id="@+id/tvCoinName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="BTC"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/black"
       />

    <!-- List of Buy/Sell Transactions -->
    <LinearLayout
        android:id="@+id/tradeHistoryLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Example Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            >

            <TextView
                android:id="@+id/tvTradeType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BUY"
                android:textSize="16sp"
                android:layout_weight="1"
                android:textColor="@color/green"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvTradeAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="0.5 BTC"
                android:gravity="center"
                android:textSize="16sp"
                android:textColor="@color/black"/>

            <TextView
                android:id="@+id/tvTradePrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="$28,000"
                android:layout_weight="1"
                android:textSize="16sp"
                android:gravity="end"
                android:textColor="@color/black"/>
        </LinearLayout>

    </LinearLayout>

    <!-- Total Holdings & Average Buy Price -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="8dp">

        <TextView
            android:id="@+id/tvTotalHoldings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Total: 1.2 BTC"
            android:textSize="16sp"
            android:layout_weight="1"
            android:textColor="@color/black"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tvAvgBuyPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Avg Buy: $25,500"
            android:layout_weight="1"
            android:gravity="end"
            android:textSize="16sp"/>
    </LinearLayout>

</LinearLayout>
