<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="16dp"
    android:orientation="vertical"
    tools:context=".dcanew.ui.DcaCalculator">

    <!-- CardView containing the inputs for position -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="5dp"
        app:cardCornerRadius="10dp"
        android:layout_marginBottom="8dp">

        <!-- Inside CardView: LinearLayout for Inputs -->
        <LinearLayout
            android:layout_width="match_parent"
            android:orientation="vertical"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <!-- Coin Price Input Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:orientation="horizontal"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="wrap_content"
                    android:text="Coin Price @"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:layout_height="wrap_content"/>

                <EditText
                    android:id="@+id/BuyPrice"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:padding="10dp"
                    android:textSize="14sp"
                    android:hint="(e.g., 115)"
                    android:inputType="numberDecimal" />

                <Spinner
                    android:layout_width="wrap_content"
                    android:id="@+id/coin_Name_spinner"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- Amount in Coin Input Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:text="Amount @"
                    android:textStyle="bold"
                    android:padding="10dp"
                    android:textSize="14sp"
                    android:layout_height="wrap_content"/>

                <EditText
                    android:id="@+id/AmountinCoin"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="(e.g., 0.5)"
                    android:padding="10dp"
                    android:textSize="14sp"
                    android:inputType="numberDecimal" />
            </LinearLayout>

            <!-- Value in USD Input Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:text="Value @"
                    android:textStyle="bold"
                    android:padding="10dp"
                    android:textSize="14sp"
                    android:layout_height="wrap_content"/>

                <EditText
                    android:id="@+id/ValueinUSD"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Value (e.g., 50 USD)"
                    android:textSize="14sp"
                    android:padding="10dp"
                    android:inputType="numberDecimal" />

            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:orientation="horizontal"
                android:layout_height="wrap_content">

            <Button
                android:id="@+id/btnAddPosition"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Add Position"

                android:textColor="@color/main3"
                android:layout_weight="1"
                android:textSize="14sp"
                />
            <ImageView
                android:id="@+id/history_button"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/baseline_history_24"
                android:layout_gravity="center"
                android:layout_marginStart="8dp"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Button and History Button Section -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="5dp"
        app:cardCornerRadius="8dp"
        android:layout_marginTop="2dp">

        <!-- All Sections Inside One CardView -->
        <LinearLayout
            android:layout_width="match_parent"
            android:orientation="vertical"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <!-- Current Price Section Inside CardView -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:elevation="5dp"
                app:cardCornerRadius="8dp"
                android:layout_marginBottom="16dp">

                <!-- Current Price Text Section -->
                <TextView
                    android:id="@+id/currentprice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="BTC: 0$ ETH: 0$ LTC: 0$ ADA: 0$"
                    android:textSize="12sp"
                    android:layout_gravity="center"
                    android:textStyle="bold"
                    android:background="@color/main"
                    android:textColor="@color/main3"
                    android:gravity="center"
                    android:padding="8dp" />
            </androidx.cardview.widget.CardView>

            <!-- Profit/Loss Summary Section Inside CardView -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:elevation="5dp"
                app:cardCornerRadius="8dp"
                android:layout_marginBottom="8dp">

                <!-- Profit/Loss Summary Section -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:orientation="horizontal"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/TotalProfitLoss"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:text="Total Profit/Loss: $0"
                        android:textSize="14sp"
                        android:gravity="center"
                        android:layout_weight="1"
                        android:background="@color/green"
                        android:textStyle="bold"
                        android:padding="8dp"/>

                    <TextView
                        android:id="@+id/TotalMoneyUsd"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:text="Total $ in Positions: $0"
                        android:textSize="14sp"
                        android:gravity="center"
                        android:layout_weight="1"
                        android:background="@color/main3"
                        android:textStyle="bold"
                        android:padding="8dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:elevation="5dp"
        android:layout_weight="1"
        app:cardCornerRadius="10dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp">
    <!-- RecyclerView to Display Positions -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/PositionsRecyclerView"
            android:layout_width="match_parent"
            android:padding="4dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:paddingTop="8dp" />
    </androidx.cardview.widget.CardView>

</LinearLayout>
